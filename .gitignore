###############################################################################
# Athena Client — .gitignore
#
# Excludes files and directories that must not be tracked in version control.
# Organised by category for maintainability.
###############################################################################


# Node.js dependencies
# --------------------
# Dependencies are resolved at deploy/build time via npm ci.
# package-lock.json IS committed to pin exact versions for reproducible builds.
/node_modules/


# Environment & secrets
# ---------------------
# All environment-specific configuration must be supplied via .env files
# that are NEVER committed. Use .env.example as the documentation template.
.env
.env.local
.env.*.local


# Vite build output
# -----------------
/dist/
/dist-ssr/


# Vite cache
# ----------
.vite/


# TypeScript
# ----------
*.tsbuildinfo


# Application runtime artefacts
# ------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Test coverage
# -------------
/coverage/


# IDE & editor
# ------------
.idea/
.vscode/
*.swp
*.swo
*~
nbproject/
.netbeans/


# OS-generated metadata
# ---------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
